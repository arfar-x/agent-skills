# Environment variables read by the toolsets and the MCP server.
# Copy to .env and fill in what you use; leave the rest unset. Never commit .env.
# Each toolset only needs its own block. Credentials come from the environment
# only (see AUTHENTICATION.md for per-caller credentials over MCP).

# ---- Jira ------------------------------------------------------------------
JIRA_BASE_URL=https://jira.example.com
# cloud | server
JIRA_DEPLOYMENT_TYPE=server
# Personal access token / bearer token, or username + password (Basic auth).
JIRA_PAT=
JIRA_USERNAME=
JIRA_PASSWORD=
# Skip the confirm step before writes (log work, transition, create, edit).
JIRA_AUTO_CONFIRM_WRITES=false
# Default project key, if you always work in one.
JIRA_DEFAULT_PROJECT=
JIRA_CACHE_TTL_SECONDS=

# ---- Confluence ------------------------------------------------------------
CONFLUENCE_BASE_URL=https://confluence.example.com
# cloud | server
CONFLUENCE_DEPLOYMENT_TYPE=server
CONFLUENCE_PAT=
CONFLUENCE_USERNAME=
CONFLUENCE_PASSWORD=
CONFLUENCE_AUTO_CONFIRM_WRITES=false
CONFLUENCE_DEFAULT_SPACE=
CONFLUENCE_CACHE_TTL_SECONDS=

# ---- GitLab ----------------------------------------------------------------
GITLAB_BASE_URL=https://gitlab.example.com
# Scope read_api for read-only use; api to comment, commit or open merge requests.
GITLAB_TOKEN=
# Numeric id or group/project path.
GITLAB_DEFAULT_PROJECT=
GITLAB_AUTO_CONFIRM_WRITES=false
GITLAB_VERIFY_SSL=true
GITLAB_TIMEOUT_SECONDS=
GITLAB_MAX_RETRIES=

# ---- Sentry ----------------------------------------------------------------
# Scopes event:read and project:read.
SENTRY_AUTH_TOKEN=
SENTRY_BASE_URL=https://sentry.io/api/0

# ---- MCP server (mcp-server/server.py) -------------------------------------
# Directory the attachment tools may read from and save into. Unset = no local files.
AGENT_SKILLS_ATTACHMENT_DIR=
# 1 = each request may use only its own user's folder of the attachment directory.
MCP_ATTACHMENT_DIR_PER_USER=
# 1 = accept per-request credentials from trusted headers instead of the environment.
MCP_TRUST_REQUEST_CREDENTIALS=
# Value a client sends to mean "header not set".
MCP_UNSET_HEADER_VALUE=
# Inbound auth (Keycloak) for the http/sse transports.
MCP_AUTH_KEYCLOAK_REALM_URL=
MCP_AUTH_KEYCLOAK_AUDIENCE=
# Root of the skills tree, when not the default.
AGENT_SKILLS_REPO_ROOT=
# Image build: include skills marked internal.
INSTALL_INTERNAL_SKILLS=
